{
  "name": "fish-aquarium",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-contained Aqualator frontend with an independent cloud backend",
  "scripts": {
    "dev": "npm run build && node scripts/serve.mjs",
    "start": "npm run build && node scripts/serve.mjs",
    "build": "node scripts/verify-assets.mjs && node scripts/build-mobile-optimized.mjs",
    "test": "npm run build && npm run test:backend && npm run test:performance && node tests/frontend.mjs",
    "test:backend": "node --test tests/backend*.mjs",
    "test:frontend": "npm run build && node tests/frontend.mjs",
    "test:performance": "node --test tests/performance.mjs"
  },
  "dependencies": {
    "@vercel/blob": "2.8.0"
  },
  "devDependencies": {
    "playwright": "1.57.0"
  },
  "engines": {
    "node": "22.x"
  }
}
