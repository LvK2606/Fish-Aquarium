{
  "name": "fish-aquarium",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-contained Aqualator frontend with an independent cloud backend",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "build": "node scripts/verify-assets.mjs && node scripts/build-static.mjs",
    "test": "node --test tests/backend*.mjs && node tests/frontend.mjs",
    "test:backend": "node --test tests/backend*.mjs tests/png-lossless.mjs tests/adaptive-graphics.mjs",
    "test:frontend": "node tests/frontend.mjs",
    "test:frontend:deploy": "SERVE_DEPLOY_OUTPUT=1 node tests/frontend.mjs"
  },
  "dependencies": {
    "@vercel/blob": "2.8.0"
  },
  "devDependencies": {
    "playwright": "1.57.0"
  },
  "engines": {
    "node": "22.x"
  }
}
